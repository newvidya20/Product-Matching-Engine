{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run index:study-material && vite build",
    "start": "node --max-old-space-size=360 --import tsx server.ts",
    "prestart": "node scripts/ensure-study-material-index.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/field-map.test.ts tests/validators.test.ts tests/merge.test.ts tests/apply-field-results.test.ts tests/fixtures.test.ts tests/llm-provider.test.ts tests/document-formats.test.ts tests/local-classifier.test.ts tests/local-extraction.test.ts tests/offline-extraction.test.ts tests/ocr-safety.test.ts tests/eligibility-engine.test.ts tests/eligibility-prefill.test.ts tests/eligibility-routes.test.ts tests/gstr3b.test.ts",
    "index:study-material": "tsx scripts/buildStudyMaterialReference.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "2.10.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
