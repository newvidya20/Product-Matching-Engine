# Shared app config
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# Required for Gemini-powered policy explanations
GEMINI_API_KEY=

# Optional: service account-based Google Sheets/Drive sync
GOOGLE_SERVICE_ACCOUNT_JSON={
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "your-service-account@your-project.iam.gserviceaccount.com",
  "client_id": "1234567890",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com"
}

# Optional: auto-connect to a known spreadsheet
GOOGLE_SHEETS_SPREADSHEET_ID=

# Document AI (see docs/contracts.md sections 7.1 and 9)
# Storage root. Render free plans have an ephemeral disk: use a paid instance with a persistent disk for real use.
DOCUMENT_AI_DATA_DIR=data/document-ai
# Unlock codes for Document AI routes. Use at least 16 random characters. With none set, production fails closed.
DOCUMENT_AI_ACCESS_CODE=
DOCUMENT_AI_ADMIN_CODE=
# Optional signing secret for session cookies (16+ random characters), independent of the codes. If empty, a random
# secret is generated once and stored (mode 0600) as session-secret under DOCUMENT_AI_DATA_DIR.
DOCUMENT_AI_SESSION_SECRET=
# Set to false to force Document AI off, overriding settings.
DOCUMENT_AI_ENABLED=
# Gemini model used by Document AI extraction.
DOCUMENT_AI_GEMINI_MODEL=gemini-3.8-flash

# AI provider for every AI feature: openrouter or gemini. Unset: OpenRouter when its key is set, else Gemini.
# Gemini settings above stay valid, so switching back is just LLM_PROVIDER=gemini.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free models by default (no credits needed). Digital PDFs go as extracted text; scanned PDFs need a paid
# model with OPENROUTER_PDF_INPUT=file.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
# Privacy: false (default) uses only providers that do not collect data. true also allows free models
# whose providers may train on prompts (better extraction, but borrower KYC documents are shared).
OPENROUTER_ALLOW_DATA_COLLECTION=false
OPENROUTER_PDF_INPUT=text
# Optional: output token cap per request (default 12000).
OPENROUTER_MAX_TOKENS=12000

# Document AI access. With no access code set, uploads are open to anyone who can reach the app.
# Set DOCUMENT_AI_REQUIRE_ACCESS_CODE=true (and the two codes) to require a code before uploads.
DOCUMENT_AI_REQUIRE_ACCESS_CODE=false

# Largest single upload (a ZIP of many documents), in MB. Default 2048. One document inside can be up to 50 MB.
DOCUMENT_AI_MAX_UPLOAD_MB=2048
